+    if (!checked) {
+        checked = 1;
+        trig = getenv("RECOMP_SNAP_TRIGGER");
+    }
+    if (!trig || GetFileAttributesA(trig) == INVALID_FILE_ATTRIBUTES)
+        return;
+    f = fopen(trig, "rb");
+    if (!f)
+        return;
+    n = fread(path, 1, sizeof path - 1, f);
+    fclose(f);
+    while (n && (path[n - 1] == '\n' || path[n - 1] == '\r' || path[n - 1] == ' '))
+        n--;
+    path[n] = 0;
+    DeleteFileA(trig);
+    if (n) {
+        const char *seq = getenv("RECOMP_SNAP_SEQ");
+        if (seq && atoi(seq) > 0 && !s_seq_want) {
+            snprintf(s_seq_base, sizeof s_seq_base, "%s", path);
+            if (n > 4 && !_stricmp(s_seq_base + n - 4, ".bmp"))
+                s_seq_base[n - 4] = 0;
+            s_seq_want = atoi(seq) > 64 ? 64 : atoi(seq);
+            s_seq_have = 0;
+            return;
+        }
+        if (getenv("RECOMP_SNAP_PRESENTED") && gpu_present_active()) {
+            gpu_present_capture(path);    /* what the window shows */
+            return;
+        }
+        s_dump_quiet = 1;
+        xbox_FramebufferDumpBmp(path);
+        s_dump_quiet = 0;
+    }
