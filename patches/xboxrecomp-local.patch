+        if (c < 0 || (pad && c > C_RT)) {
+            fprintf(stderr, "[INPUT] %s: unknown control \"%s%s\"\n", path, pad ? "pad." : "", name);
+            continue;
+        }
+        if (pad) {
+            int src = -1;
+            for (i = 0; i < P_COUNT; i++)
+                if (!strcmp(val, k_src[i])) { src = i; break; }
+            if (src < 0) {
