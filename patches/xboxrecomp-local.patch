+    while (fgets(line, sizeof line, f)) {
+        char *p, *name, *val, *e;
+        int i, c = -1, pad = 0;
+        for (p = line; *p; p++) {
+            if (*p == '#' || *p == ';' || *p == '\r' || *p == '\n') { *p = 0; break; }
