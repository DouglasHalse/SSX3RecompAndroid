+        }
+        fprintf(stderr, "[INPUT] %s%s = %s\n", pad ? "pad." : "", name, val);
+        n++;
+    }
+    fclose(f);
+    fprintf(stderr, "[INPUT] %s: %d binding(s)\n", path, n);
+    fflush(stderr);
+}
 
