+        while (*name == ' ' || *name == '\t') name++;
+        while (*val == ' ' || *val == '\t') val++;
+        for (e = name + strlen(name); e > name && (e[-1] == ' ' || e[-1] == '\t'); ) *--e = 0;
+        for (e = val + strlen(val); e > val && (e[-1] == ' ' || e[-1] == '\t'); ) *--e = 0;
