+}
+
+/* Raw disk device: Partition0.img carries the partition table at 0x800
+ * (see the Windows branch above for why a title reads it). */
+static void xbox_write_partition_table(const char *path)
+{
+    static const struct { const char *name; uint32_t start, size; } parts[] = {
+        { "XBOX_PART_X",  0x00000400, 0x00177000 },
+        { "XBOX_PART_Y",  0x00177400, 0x00177000 },
+        { "XBOX_PART_Z",  0x002EE400, 0x00177000 },
+        { "XBOX_PART_C",  0x00465400, 0x000FA000 },
+        { "XBOX_PART_E",  0x0055F400, 0x00465400 },
+    };
+    unsigned char sector[512];
+    int fd = open(path, O_WRONLY | O_CREAT, 0644);
+    size_t i;
+
+    if (fd < 0)
+        return;
+    memset(sector, 0, sizeof(sector));
+    memcpy(sector, "****PARTINFO****", 16);
+    for (i = 0; i < sizeof(parts) / sizeof(parts[0]); i++) {
+        unsigned char *e = sector + 48 + i * 32;
+        size_t n = strlen(parts[i].name);
+        uint32_t flags = 0x80000000u, zero = 0;
+        memset(e, ' ', 16);
+        memcpy(e, parts[i].name, n < 16 ? n : 16);
+        memcpy(e + 16, &flags, 4);
+        memcpy(e + 20, &parts[i].start, 4);
+        memcpy(e + 24, &parts[i].size, 4);
+        memcpy(e + 28, &zero, 4);
+    }
+    if (pwrite(fd, sector, sizeof(sector), 0x800) < 0)
+        xbox_log(XBOX_LOG_WARN, XBOX_LOG_PATH, "partition table write: %s", strerror(errno));
+    close(fd);
+}
+
+/* \Device\Harddisk0\PartitionN with nothing below it -> <save>/PartitionN.img */
+static BOOL xbox_partition_device_path(const char *xbox_path, char *out, DWORD n)
+{
+    static const char *prefix = "\\Device\\Harddisk0\\Partition";
+    int len = match_prefix(xbox_path, prefix);
+    int digit;
+    const char *rest;
+
+    if (!len)
+        return FALSE;
+    digit = xbox_path[len];
+    if (digit < '0' || digit > '9')
+        return FALSE;
+    rest = xbox_path + len + 1;
+    /* With a trailing separator a partition is opened as a directory (XAPI
+     * mounting E:), which the rules table serves; only the bare device name,
+     * the raw volume a format writes to, is the image. */
+    if ((*rest == '\\' || *rest == '/') && digit == '0')
+        rest++;
+    if (*rest != '\0')
+        return FALSE;
+
+    mkdir_p(s_save_dir);
+    snprintf(out, n, "%s/Partition%c.img", s_save_dir, digit);
+    if (digit == '0' && access(out, F_OK) != 0)
+        xbox_write_partition_table(out);
+    return TRUE;
+}
+
+/* The partition devices 1-5 as sparse images sized like the table above, as
+ * on Windows. XAPI formats a cache partition at boot and sizes the volume
+ * from IOCTL_DISK_GET_PARTITION_INFO, which reports the image's size: with
+ * the device mapped to a directory that was 0, the format failed with
+ * ERROR_DISK_FULL and the title quit to the dashboard. */
+static void xbox_create_partition_images(void)
+{
+    static const unsigned long long part_sectors[6] = {
+        0,             /* 0: whole disk, the table only */
+        0x00465400ull, /* 1: E: game and saves          */
+        0x000FA000ull, /* 2: C: system                  */
+        0x00177000ull, /* 3: X: cache                   */
+        0x00177000ull, /* 4: Y: cache                   */
+        0x00177000ull, /* 5: Z: cache                   */
+    };
+    char image[MAX_PATH];
+    struct stat st;
+
+    snprintf(image, sizeof(image), "%s/Partition0.img", s_save_dir);
+    if (access(image, F_OK) != 0)
+        xbox_write_partition_table(image);
+    for (int p = 1; p <= 5; p++) {
+        off_t want = (off_t)(part_sectors[p] * 512ull);
+        int fd;
+
+        snprintf(image, sizeof(image), "%s/Partition%d.img", s_save_dir, p);
+        if (stat(image, &st) == 0 && st.st_size == want)
+            continue;
+        fd = open(image, O_WRONLY | O_CREAT, 0644);
+        if (fd < 0) {
+            xbox_log(XBOX_LOG_WARN, XBOX_LOG_PATH, "%s: %s", image, strerror(errno));
+            continue;
+        }
+        if (ftruncate(fd, want) != 0)
+            xbox_log(XBOX_LOG_WARN, XBOX_LOG_PATH, "%s: %s", image, strerror(errno));
+        close(fd);
+    }
+}
